{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "justMyCode": false,
            "python": "${command:python.interpreterPath}",
            "cwd": "${workspaceFolder}",
            "subProcess": true,
            "stopOnEntry": false,
            "redirectOutput": true,
            //"args": ["--create_GADM_raster", "--resolution", "6.00"],
            //"args": ["--process", "no_copy", "--ssp_baseline", "SSP2"],
            //"args": ["--downscale_population", "--scenario", "ELV-SSP2-CP", "--model", "IMAGE", "--profile", "third_round"],
            //"args": ["--downscale_gdp_ppp", "--scenario", "ELV-SSP2-CP", "--model", "IMAGE", "--profile", "second_round"],
            "args": ["--downscale_emissions", "--scenario", "ELV-SSP2-CP", "--model", "IMAGE", "--profile", "second_round", "--emissions", "net"],
            //"args": ["--downscale_emissions", "--scenario", "ELV-SSP2-1150F", "--model", "IMAGE", "--profile", "fifth_round"],
            //"args": ["--plot", "--scenario", "ELV-SSP2-1150F", "--model", "IMAGE", "--profile", "third_round",  "--emissions", "net", "--global_min", "-0.007856", "--global_max", "0.120754"],
            //"args": ["--plot", "--scenario", "ELV-SSP2-CP", "--model", "IMAGE", "--profile", "first_round", "--emissions", "net"],
            //"args": ["--upload", "--scenario", "ELV-SSP2-CP", "--model", "IMAGE", "--profile", "second_round"],
            //"args": ["--compare"],
            "env": {
                "CONDA_PREFIX": "${workspaceFolder}\\.pixi\\envs\\default",
                "PATH": "${workspaceFolder}\\.pixi\\envs\\default;${workspaceFolder}\\.pixi\\envs\\default\\Library\\bin;${workspaceFolder}\\.pixi\\envs\\default\\Scripts;${env:PATH}",
                "MPLBACKEND": "Agg",
                "PYDEVD_USE_CYTHON": "NO",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            }
        }
    ]
}
